# SSH target used to open the reverse tunnel.
# Replace with the real SSH user and public server host/IP in your local .env.
SSH_HOST=user@203.0.113.10

# Public address shown in curl examples.
# 203.0.113.10 is a documentation/example IP.
PUBLIC_IP=203.0.113.10

# Public port on the SSH server.
REMOTE_PORT=9000

# Bind address on the remote server.
# 0.0.0.0 exposes the forwarded port publicly if sshd allows GatewayPorts.
REMOTE_BIND=0.0.0.0

# Default CUPS printer used when request does not include printer=...
DEFAULT_PRINTER=

# Local upload directory.
UPLOAD_DIR=./uploads

# Local TOTP secret file.
# Do not commit the real generated file.
TOTP_SECRET_FILE=./totp_secret.txt

# Limits.
MAX_FILE_SIZE_MB=50
MAX_SAVED_FILES=20

# TOTP label shown in authenticator apps.
TOTP_ISSUER=fiprint
TOTP_ACCOUNT=local-printer
